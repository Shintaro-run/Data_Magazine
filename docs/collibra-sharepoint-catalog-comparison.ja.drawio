        <mxCell id="calloutA" value="&lt;b&gt;こんな案&lt;/b&gt;&lt;br&gt;🛟 Collibra公式サポート付き&lt;br&gt;💰 純正課金で割高&lt;br&gt;🔧 設定だけ・保守ラク" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
