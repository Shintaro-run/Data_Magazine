        <mxCell id="eA1" value="① AIが自動で取り込み・整理" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;fontSize=11;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="A1" target="A2">
