        <mxCell id="A2" value="&lt;font style=&quot;font-size:30px&quot;&gt;🗄️&lt;/font&gt; &lt;font style=&quot;font-size:24px&quot;&gt;🤖&lt;/font&gt;&lt;br&gt;&lt;b&gt;Collibra(純正)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;Marketplace 機能で公開&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="215" y="300" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="A3" value="&lt;font style=&quot;font-size:30px&quot;&gt;👤&lt;/font&gt;&lt;br&gt;&lt;b&gt;閲覧者&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px&quot;&gt;ライセンス不要で閲覧OK&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="240" y="470" width="190" height="96" as="geometry" />
