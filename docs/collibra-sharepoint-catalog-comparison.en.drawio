        <mxCell id="calloutB" value="&lt;b&gt;This option&lt;/b&gt;&lt;br&gt;💰 No extra Collibra license&lt;br&gt;🛠 Build &amp; maintain in-house&lt;br&gt;🎨 Fully customizable presentation&lt;br&gt;📂 Reuses existing SharePoint assets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
